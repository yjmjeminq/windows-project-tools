     // sound, nothing else). The gates are widened to the limit of the save's card table
     // rather than removed, so ids below 3900 - an empty deck slot is id 0 - are still
     // rejected exactly as in the unmodified game.
+    void ExtendRaceFilter()
+    {
+        struct Option
+        {
+            uint64_t Index;
+            uint64_t TextId;
+            uintptr_t GetName;
+            int32_t Icon;
+            uint32_t Padding;
+            uint64_t Mask;
+        };
+        struct List
+        {
+            uint64_t Count;
+            const Option* Options;
+        };
+        static_assert(sizeof(Option) == 40 && sizeof(List) == 16);
+        constexpr uintptr_t descriptor = 0x140A7A390;
+        constexpr uintptr_t stockOptions = 0x140A7B210;
+        constexpr uintptr_t raceName = 0x140870200;
+        constexpr size_t stockCount = 24;
+        const auto& stock = *reinterpret_cast<const List*>(descriptor);
+        if (stock.Count != stockCount || reinterpret_cast<uintptr_t>(stock.Options) != stockOptions
+            || stock.Options[stockCount - 1].GetName != raceName
+            || stock.Options[stockCount - 1].Mask != (1ull << stockCount))
+        {
+            Logger::WriteLog("Race filter options did not match this game version", MODULE_NAME, 2);
+            return;
+        }
+
+        static Option options[26]{};
+        std::copy_n(stock.Options, stockCount, options);
+        for (const auto race : { Card::CreatorGod, Card::Illusion })
+        {
+            const auto id = static_cast<unsigned>(race);
+            options[id - 1] = { id - 1, 0, raceName, -1, 0, 1ull << id };
+        }
+        const List replacement{std::size(options), options};
+        if (YGO::Memory::WriteValue(descriptor, replacement))
+            Logger::WriteLog("Race filter includes Creator God and Illusion", MODULE_NAME, 0);
+    }
