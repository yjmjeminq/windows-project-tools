# Keep local game inputs outside the tracked source tree.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Play-YGO.cmd
!/Setup-YGO.cmd
!/Setup-YGO.ps1
!/Update-PC.cmd
!/Fixes/
!/Switch-Port/
!/Mods/

/Fixes/*
!/Fixes/OfflineDuelListFix.cpp
!/Fixes/PC-CardRaceAndRelatedCards.patch
!/Fixes/PortableLoader.patch
!/Fixes/StartGame.ps1

/Switch-Port/*
!/Switch-Port/Tools/
/Switch-Port/Tools/*
!/Switch-Port/Tools/*.py

/Mods/*
!/Mods/2020-2021-Cards/
!/Mods/Anime-Sanctity/

/Mods/2020-2021-Cards/*
!/Mods/2020-2021-Cards/mod.json
!/Mods/2020-2021-Cards/README.txt
!/Mods/2020-2021-Cards/Yu-Gi-Oh-Ex/
/Mods/2020-2021-Cards/Yu-Gi-Oh-Ex/*
!/Mods/2020-2021-Cards/Yu-Gi-Oh-Ex/Archetypes.json
!/Mods/2020-2021-Cards/Yu-Gi-Oh-Ex/cards.json
!/Mods/2020-2021-Cards/Yu-Gi-Oh-Ex/relatedcards.json
!/Mods/2020-2021-Cards/Yu-Gi-Oh-Ex/unlocks.json

/Mods/Anime-Sanctity/*
!/Mods/Anime-Sanctity/Config.ini
!/Mods/Anime-Sanctity/mod.json
!/Mods/Anime-Sanctity/Yu-Gi-Oh-Ex/
/Mods/Anime-Sanctity/Yu-Gi-Oh-Ex/*
!/Mods/Anime-Sanctity/Yu-Gi-Oh-Ex/cards.json
